LangChain中提供了文档加载的统一接口BaseLoader,以及表示文档结果的类型Document

class BaseLoader(ABC):
    def load(self) -> List[Document]:
        """加载文档"""
        pass

class BaseMedia(Serializable):
    id : str | None
    """唯一标识,可选"""

    metadata:dict[Any,Any]
    """与内容关联的元数据"""

class Document(BaseMedia):
    page_content: str
